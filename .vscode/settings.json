{
  "files.exclude": {
    "Gemfile.lock": true,
    ".npmrc": true,
    "package-lock.json": true,
    "similarity.cache": true,
    "stackprof.dump": true,
    "node_modules": true,
    "public": true,
    "**/.gitkeep": true,
    "**/.gitattributes": true,
    "**/coverage": true,
    "**/.rspec": true,
    "**/.simplecov": true
  },
  "rubyLsp.rubyVersionManager": {
    "identifier": "mise"
  },
  "rubyLsp.erbSupport": false,
  "rubyLsp.formatter": "none",
  "rubyLsp.pullDiagnosticsOn": "save"
}
